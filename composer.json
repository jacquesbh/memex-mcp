{
    "name": "monsieurbiz/memex-mcp",
    "description": "MEMEX - MCP server for managing guides and contexts knowledge base. Inspired by Vannevar Bush's vision of augmented memory.",
    "type": "project",
    "require": {
        "php": "^8.4",
        "claude-php/claude-3-api": "^0.1.23",
        "jolicode/castor": "^1.7",
        "laravel-zero/phar-updater": "^1.4",
        "league/commonmark": "^2.7",
        "mcp/sdk": "dev-main",
        "symfony/ai-platform": "~0.3.0",
        "symfony/ai-store": "~0.3.3",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "authors": [
        {
            "name": "MonsieurBiz"
        }
    ],
    "autoload": {
        "psr-4": {
            "Memex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Memex\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/thanks": true
        }
    }
}
